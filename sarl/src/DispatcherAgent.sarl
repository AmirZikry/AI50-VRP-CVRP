import io.sarl.api.core.DefaultContextInteractions
import io.sarl.api.core.Initialize
import io.sarl.api.core.Lifecycle
import io.sarl.api.core.Logging
import io.sarl.api.core.Schedules
import java.io.File
import java.net.InetSocketAddress
import java.nio.file.Files
import java.util.ArrayList
import java.util.Arrays
import java.util.HashMap
import java.util.List
import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.ConcurrentLinkedQueue
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicInteger
import org.java_websocket.WebSocket
import org.java_websocket.handshake.ClientHandshake
import org.java_websocket.server.WebSocketServer

/** Holds a client socket connection and the path to the requested VRP instance file.
 */
class SimulationJob {
	public val client : WebSocket
	public val filePath : String

	new(client : WebSocket, filePath : String) {
		this.client = client
		this.filePath = filePath
	}
}

/** Stores a single vehicle's completed route and distance cost.
 */
class VehicleResult {
	public val vehicleId : int
	public val cost : long
	public val route : List<String>

	new(vehicleId : int, cost : long, route : List<String>) {
		this.vehicleId = vehicleId
		this.cost = cost
		this.route = route
	}
}

/** Manages WebSocket requests, parses VRP files, coordinates vehicle agents, and returns results.
 */
agent DispatcherAgent {
	uses Logging, DefaultContextInteractions, Lifecycle, Schedules
	
	val jobQueue = new ConcurrentLinkedQueue<SimulationJob>()
	val stateLock = new Object()
	
	var activeJob : SimulationJob = null
	var isRunning = false
	var totalVehicles = 0
	var vehiclesReady = 0
	var vehiclesReporting = 0
	var totalSystemCost : long = 0
	val collectedRoutes = new ArrayList<VehicleResult>()

	/** Starts the WebSocket server to queue incoming requests and polls the queue every 50ms when idle.
	 */
	on Initialize {
		val port = occurrence.parameters.get(0) as Integer
	
		new WebSocketServer(new InetSocketAddress(port)) {
			override onOpen(conn : WebSocket, handshake : ClientHandshake) {
				info("Python client connected: " + conn.remoteSocketAddress)
			}
	
			override onMessage(conn : WebSocket, message : String) {
				info("Received VRP instance request: " + message)
				jobQueue.add(new SimulationJob(conn, message.trim))
			}
	
			override onClose(conn : WebSocket, code : int, reason : String, remote : boolean) {
				info("Python client disconnected.")
			}
	
			override onError(conn : WebSocket, ex : Exception) {
				error("WebSocket error: " + ex.message)
			}
	
				override onStart {
				info("SARL VRP Server ready and listening on ws://localhost:" + port)
			}
		}.start()
	
			every(50) [
			if (!this.isRunning) {
				val nextJob = this.jobQueue.poll()
				if(nextJob !== null) runSimulation(nextJob)
			}
		]
	}

	/** Parses the VRP file, populates the shared customer task board, and spawns the minimum required fleet.
	 */
	def runSimulation(job : SimulationJob) {
		val file = new File(job.filePath)
		if (!file.exists || !file.isFile) {
			sendToClient(job.client, '{"status":"error","message":"File not found: ' + job.filePath.replace("\\", "\\\\") + '"}')
			error("Instance file not found: " + job.filePath)
			return
		}

		this.isRunning = true
		this.activeJob = job
		this.vehiclesReady = 0
		this.vehiclesReporting = 0
		this.totalSystemCost = 0
		this.collectedRoutes.clear()

		var myCapacity = 0

		var depotNodeId = "1"
		var section = ""
		val coords = new HashMap<String, int[]>()
		val rawDemands = new HashMap<String, Integer>()

		// Extract vehicle capacity, node coordinates, customer demands, and depot ID
		for (rawLine : Files.readAllLines(file.toPath)) {
			val line = rawLine.trim
			if (line.startsWith("CAPACITY")) {
				myCapacity = Integer.parseInt(line.split("\\s*:\\s*").get(1))
			} else if (#["NODE_COORD_SECTION", "DEMAND_SECTION", "DEPOT_SECTION", "EOF"].contains(line)) {
				section = line
			} else if (section == "NODE_COORD_SECTION" && line.matches("^\\d+\\s+.*")) {
				val parts = line.split("\\s+")
				coords.put(parts.get(0), #[Integer.parseInt(parts.get(1)), Integer.parseInt(parts.get(2))])
			} else if (section == "DEMAND_SECTION" && line.matches("^\\d+\\s+.*")) {
				val parts = line.split("\\s+")
				rawDemands.put(parts.get(0), Integer.parseInt(parts.get(1)))
			} else if (section == "DEPOT_SECTION" && line.matches("^\\d+$")) {
				depotNodeId = line
			}
		}

		val depotXY = coords.get(depotNodeId)
		val board = new ConcurrentHashMap<String, VrpTask>()
		var totalDemand = 0

		// Populate the shared job board with non-depot customer tasks
		for (entry : rawDemands.entrySet) {
			val nodeId = entry.key
			val demand = entry.value
			if (nodeId != depotNodeId && demand > 0) {
				val customerId = String.valueOf(Integer.parseInt(nodeId) - 1)
				val xy = coords.get(nodeId)
				totalDemand += demand
				board.put(customerId, new VrpTask(customerId, demand, xy.get(0), xy.get(1)))
			}
		}

		// Calculate minimum fleet size (ceil(totalDemand / capacity)) and spawn vehicles
		this.totalVehicles = (totalDemand + myCapacity - 1) / myCapacity val sharedRoutes = new ConcurrentHashMap<Integer, List<VrpTask>>()
		val clusteredCount = new AtomicInteger(0)
		val optimizationDone = new AtomicBoolean(false)

		info("Spawning " + this.totalVehicles + " vehicles for " + file.name + "...")
		for (i : 1 .. this.totalVehicles) {
			spawn(typeof(VehicleAgent), myCapacity , depotXY.get(0), depotXY.get(1), board, i, this.totalVehicles,
				sharedRoutes, clusteredCount, optimizationDone)
		}
	}

	/** Waits for all spawned vehicles to check in before starting the simulation.
	 */
	on VehicleReady {
		synchronized ( this.stateLock) {
			this.vehiclesReady++
			if (this.vehiclesReady == this.totalVehicles) {
				info("All " + this.totalVehicles + " vehicles ready. Starting simulation...")
				emit(new StartSimulation())
			}
		}
	}

	/** Aggregates finished vehicle routes, logs the solution, and sends JSON results to the client.
	 */
	on RouteCost {
		synchronized (this.stateLock) {
			this.totalSystemCost += occurrence.cost
			this.vehiclesReporting++

			val trimmed = occurrence.route.trim
			val routeNodes = if (trimmed.isEmpty) new ArrayList<String>() else Arrays.asList(trimmed.split("\\s+"))
			this.collectedRoutes.add(new VehicleResult(occurrence.vehicleId, occurrence.cost, routeNodes))

			if (this.vehiclesReporting == this.totalVehicles) {
				this.collectedRoutes.sort[a, b | Integer.compare(a.vehicleId, b.vehicleId)]

				info("===============================================")
				info("SIMULATION COMPLETE: " + new File(this.activeJob.filePath).name)
				for (res : this.collectedRoutes) {
					info("Route #" + res.vehicleId + ": " + String.join(" ", res.route))
				}
				info("Cost " + this.totalSystemCost)
				info("===============================================")

				val routesJson = this.collectedRoutes.map [ res |
					val pathJson = res.route.map['"' + it + '"'].join(",")
					'{"vehicle":' + res.vehicleId + ',"cost":' + res.cost + ',"path":[' + pathJson + ']}'
				].join(",")
				sendToClient(this.activeJob?.client,
					'{"status":"ok","total_cost":' + this.totalSystemCost + ',"routes":[' + routesJson + ']}')

				this.isRunning = false
				this.activeJob = null
			}
		}
	}

	/** Safely transmits a payload if the client WebSocket connection is still open.
	 */
	def sendToClient(client : WebSocket, payload : String) {
		if (client !== null && client.isOpen) client.send(payload)
	}
}
